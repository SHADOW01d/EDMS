# Copy this file to .env for local development. Do not commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set these to long, random URL-safe secrets before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret

# Local Docker Compose services are bound to localhost.
DATABASE_URL=postgres://edms:replace-with-a-long-random-secret@localhost:5432/edms
REDIS_URL=redis://:replace-with-a-different-long-random-secret@localhost:6379/0

# Generate VAPID keys with: pywebpush --generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com
